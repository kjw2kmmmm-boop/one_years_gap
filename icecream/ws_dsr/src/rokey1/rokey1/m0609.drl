def grip_grap():
    global System_home
    # WaitNode
    wait(0.20)
    # SetNode
    set_digital_output(1,ON)
    # SetNode
    set_digital_output(1,OFF)
    # WaitNode
    wait(3.00)
    
_alias_sub_name_grip_grap = grip_grap

def grip_release():
    global System_home
    # WaitNode
    wait(0.20)
    # SetNode
    set_digital_output(2,ON)
    # SetNode
    set_digital_output(2,OFF)
    # WaitNode
    wait(2.50)
    
_alias_sub_name_grip_release = grip_release

