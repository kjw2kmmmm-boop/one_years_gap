def detecting_gear():
    global System_home
    # SetNode
    set_ref_coord(1)
    # ComplianceNode
    task_compliance_ctrl()
    set_stiffnessx([3000.00, 3000.00, 3000.00, 200.00, 200.00, 200.00],time=0.0)
    # ForceNode
    set_desired_force([0.00, 0.00, 10.00, 0.00, 0.00, 0.00],[0,0,1,0,0,0],time=0.0,mod=DR_FC_MOD_ABS)
    # RepeatNode
    while True:
        if check_force_condition(axis=DR_AXIS_Z, min=10, ref=DR_TOOL):
            break
            
        
    # CallNode
    global _alias_sub_name_gear_periodic
    _alias_sub_name_gear_periodic()
    # ForceNode
    release_force(time=0.0)
    # ComplianceNode
    release_compliance_ctrl()
    
_alias_sub_name_detecting_gear = detecting_gear

set_singular_handling(DR_AVOID)
