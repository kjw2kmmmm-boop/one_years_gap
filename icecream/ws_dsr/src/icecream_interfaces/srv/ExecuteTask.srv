# Request
string command                 # 실행할 명령 이름 ("MOVE_HOME", "MOVE_TO_SCOOP", "MOVE_CUP_Z", "MOVE_TO_PLATE", "MOVE_TO_FLAVOR", "GRIP_AND_LIFT", "GRIPPER_RELEASE", "GRIPPER_GRAB", "CALIBRATE_CUP_Z", "DISPENSE_CUP", "CLEAN_SCOOP", "RELEASE_SCOOP")
string target                  # 보조 타겟 식별자 (예: "CHOCO", "VANILLA", "SLOT_1" 등, 필요 없으면 "")

---
# Response
bool success                   # 동작 성공 여부
int32 error_code               # 0: 정상, 1: 모션 에러, 2: 알 수 없는 명령, 3: 강제 중단
string message                 # 상세 결과 메시지
